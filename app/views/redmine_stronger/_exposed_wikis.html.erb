<div class="box" id="<%= anchor %>">
  <h3><%= title %></h3>

  <% if rows.empty? %>
    <p class="icon icon-ok"><%= sprite_icon('checked') %><%= empty_message %></p>
  <% else %>
    <%# Projects without any page expose nothing yet: folded when asked, the list being long otherwise %>
    <% shown, folded = local_assigns[:fold_empty] ? rows.partition { |row| row.pages > 0 } : [rows, []] %>
    <%= render 'redmine_stronger/exposed_wikis_table', rows: shown, index_path: index_path if shown.any? %>
    <% if folded.any? %>
      <details class="stronger-collapsed">
        <summary><%= l(:stronger_show_empty_projects, count: folded.size) %></summary>
        <%= render 'redmine_stronger/exposed_wikis_table', rows: folded, index_path: index_path %>
      </details>
    <% end %>
  <% end %>
</div>
