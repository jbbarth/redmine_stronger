<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'stronger', plugin: 'redmine_stronger' %>
<% end %>

<h2><%= l(:label_stronger_security_dashboard) %></h2>

<%= stronger_security_tabs('overview') %>

<div class="box">
  <%= render 'stronger_security/tiles',
             tiles: stronger_overview_tiles(
               anon: @anon_total, anon_open: @anon_open,
               non_member: @non_member_total, non_member_open: @non_member_open,
               wikis: @exposed_wikis.size, wiki_projects: @wiki_projects_count,
               documentations: (@exposed_documentations.size if @documentation_supported),
               documentation_projects: @documentation_projects_count,
               inactive: @inactive_users_count, inactive_admins: @inactive_admins.size,
               locked: @locked_users.size, api: @api_users_count, api_blocked: @api_blocked_attempts.size
             ) %>
</div>

<h3 class="stronger-group-title"><%= l(:stronger_group_exposure) %></h3>

<%= render 'stronger_security/exposed_issues',
           anchor: 'stronger-anon', title: l(:stronger_section_anon_visibility), status: 'alert',
           total: @anon_total, open: @anon_open, top_projects: @anon_top_projects %>

<%= render 'stronger_security/exposed_issues',
           anchor: 'stronger-non-member', title: l(:stronger_section_non_member_visibility), status: 'vulnerable',
           total: @non_member_total, open: @non_member_open, top_projects: @non_member_top_projects %>

<%= render "redmine_stronger/exposed_wikis",
           anchor: 'stronger-wikis',
           rows: @exposed_wikis,
           index_path: :project_wiki_index_path,
           title: l(:stronger_section_non_member_wikis,
                    count: @exposed_wikis.size, total: @wiki_projects_count),
           empty_message: l(:stronger_no_non_member_wikis) %>

<% if @documentation_supported %>
  <%= render "redmine_stronger/exposed_wikis",
             anchor: 'stronger-documentations',
             fold_empty: true,
             rows: @exposed_documentations,
             index_path: :project_documentation_index_path,
             title: l(:stronger_section_non_member_documentations,
                      count: @exposed_documentations.size, total: @documentation_projects_count),
             empty_message: l(:stronger_no_non_member_documentations) %>
<% end %>

<h3 class="stronger-group-title"><%= l(:stronger_group_accounts) %></h3>

<%# Inactive accounts %>
<div class="box" id="stronger-inactive">
  <h3><%= l(:stronger_section_inactive_users,
             count: @inactive_users_count,
             days:  RedmineStronger::SecurityMetrics::INACTIVE_DAYS) %></h3>

  <% if @inactive_users_count == 0 %>
    <p class="icon icon-ok"><%= sprite_icon('checked') %><%= l(:stronger_no_inactive_users, days: RedmineStronger::SecurityMetrics::INACTIVE_DAYS) %></p>
  <% elsif @inactive_users.empty? %>
    <p class="warning">
      <%= l(:stronger_too_many_to_list,
            count: @inactive_users_count,
            threshold: RedmineStronger::SecurityMetrics::LARGE_COUNT_THRESHOLD) %>
    </p>
    <% if @inactive_admins.present? %>
      <h4><%= l(:stronger_inactive_admins) %></h4>
      <%= render 'stronger_security/inactive_users_table', users: @inactive_admins %>
    <% end %>
  <% else %>
    <%= render 'stronger_security/inactive_users_table', users: @inactive_users %>
    <% if @inactive_users_count > @inactive_users.size %>
      <p class="icon"><%= sprite_icon('3-bullets') %>
        <%= l(:stronger_inactive_users_more,
              shown: @inactive_users.size,
              total: @inactive_users_count) %>
      </p>
    <% end %>
  <% end %>
</div>

<%# Accounts using the API %>
<div class="box" id="stronger-api">
  <h3><%= l(:stronger_section_api_users, count: @api_users_count, days: RedmineStronger::SecurityMetrics::API_RECENT_DAYS) %></h3>

  <% if @api_users.empty? %>
    <p class="icon icon-ok"><%= sprite_icon('checked') %><%= l(:stronger_no_api_users, days: RedmineStronger::SecurityMetrics::API_RECENT_DAYS) %></p>
  <% else %>
    <% if @api_blocked_attempts.any? %>
      <p class="warning"><%= l(:stronger_api_blocked_summary, count: @api_blocked_attempts.size) %></p>
    <% end %>
    <table class="list stronger-table">
      <thead>
        <tr>
          <th><%= l(:field_login) %></th>
          <th><%= l(:field_user) %></th>
          <th><%= l(:stronger_api_last_used_at) %></th>
          <th><%= l(:stronger_column_outcome) %></th>
          <th><%= l(:stronger_api_provenance) %></th>
          <th class="count"><%= l(:stronger_column_api_blocked) %></th>
        </tr>
      </thead>
      <tbody>
        <% @api_users.each do |token| %>
          <% user = token.user %>
          <% next unless user %>
          <% blocked = @api_blocked_attempts[user.id].to_i %>
          <tr class="<%= user.css_classes %> stronger-row stronger-row-<%= stronger_api_row_status(blocked, @api_user_provenances[user.id]) %>">
            <td><%= link_to user.login, edit_user_path(user) %><%= stronger_admin_badge(user) %><%= stronger_trusted_api_badge(user) %></td>
            <td><%= user.name %></td>
            <td><%= format_time(token.last_used_at) %></td>
            <td><%= render 'redmine_stronger/outcome_badge', outcome: @api_user_outcomes[user.id] %></td>
            <td><%= render 'redmine_stronger/provenance_badge', provenance: @api_user_provenances[user.id] %></td>
            <td class="count">
              <% if blocked > 0 %><span class="stronger-outcome stronger-outcome-blocked"><%= blocked %></span><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <span class="pagination"><%= pagination_links_full @api_users_pages %></span>
  <% end %>
</div>

<%# Locked accounts (brute force) %>
<div class="box" id="stronger-locked">
  <h3><%= l(:stronger_section_locked_users) %></h3>

  <% if @locked_users.empty? %>
    <p class="icon icon-ok"><%= sprite_icon('checked') %><%= l(:stronger_no_locked_users) %></p>
  <% else %>
    <table class="list stronger-table">
      <thead>
        <tr>
          <th><%= l(:field_login) %></th>
          <th><%= l(:field_user) %></th>
          <th><%= l(:field_lock_comment) %></th>
        </tr>
      </thead>
      <tbody>
        <% @locked_users.each do |user| %>
          <tr class="stronger-row stronger-row-outdated">
            <td><%= link_to user.login, edit_user_path(user) %><%= stronger_admin_badge(user) %></td>
            <td><%= user.name %></td>
            <td><%= user.lock_comment %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<% html_title l(:stronger_tab_overview), l(:label_stronger_security_dashboard) %>
